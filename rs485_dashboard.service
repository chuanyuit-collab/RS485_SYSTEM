[Unit]
Description=RS485 Dashboard System (FastAPI)
After=network.target

[Service]
Type=simple
User=cys
WorkingDirectory=/home/cys/prog/RS485_SYSTEM/backend
ExecStart=/home/cys/prog/RS485_SYSTEM/venv/bin/python main.py
Restart=always
RestartSec=5
# 如果需要 root 權限讀取 COM port，可以考慮將 User 註解掉或將 cys 加入 dialout 群組
# ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target
